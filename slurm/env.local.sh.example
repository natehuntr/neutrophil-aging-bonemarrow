# Site settings. Copy to slurm/env.local.sh and edit.
#
#   cp slurm/env.local.sh.example slurm/env.local.sh
#
# This file is untracked, so a git pull will not revert it. Plain assignments
# here win: env.sh's defaults are all ${VAR:-...} and leave a set value alone.

# The R module to load. `module -t avail | grep '^R/'` lists what exists.
R_MODULE=R/4.3.2-gfbf-2023a

# Where the pipeline's packages live. Must be visible from compute nodes and
# have room for several GB -- a home directory usually does not.
R_LIBS_USER=/path/to/lab/storage/R/library-R-4.3.2-gfbf-2023a

# Optional but recommended. A GitHub personal access token raises the API rate
# limit, which is otherwise 60 requests per hour shared by every user on the
# cluster's outbound IP -- and running out is what makes installing monocle3,
# SeuratWrappers and CytoTRACE2 fail with "HTTP error 403".
#
# The installer works without one (it downloads source archives directly), but
# a token makes it more reliable. Create at github.com/settings/tokens with no
# scopes at all -- public repositories need none.
# GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
